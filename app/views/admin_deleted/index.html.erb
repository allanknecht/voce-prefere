<div class="bg-white rounded-2xl shadow-xl p-4 sm:p-6 border-4 border-black">
  <h1 class="text-2xl sm:text-3xl font-black mb-4 text-center">🗑️ Opções excluídas</h1>

  <p class="text-sm text-gray-600 mb-3">
    <%= @total %> <%= @total == 1 ? "registro" : "registros" %> • página <%= @page %> de <%= @total_pages %> • mais recentes primeiro
  </p>

  <% if @entries.any? %>
    <ul class="space-y-3">
      <% @entries.each do |entry| %>
        <li class="border-2 border-gray-300 rounded-lg p-3">
          <p class="font-bold break-words"><%= entry.text %></p>
          <p class="text-xs text-gray-600 mt-1">
            <span class="inline-block rounded px-2 py-0.5 font-bold <%= entry.reprovada? ? "bg-yellow-100 text-yellow-800" : "bg-red-100 text-red-800" %>">
              <%= entry.reprovada? ? "Reprovada" : "Excluída" %>
            </span>
            • Categoria: <%= entry.category.presence || "—" %>
            • <%= entry.deleted_at.strftime("%d/%m/%Y %H:%M") %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 text-center py-6">Nenhuma opção excluída ainda.</p>
  <% end %>

  <% if @total_pages > 1 %>
    <nav class="flex items-center justify-between gap-2 mt-4" aria-label="Paginação">
      <% if @page > 1 %>
        <%= link_to "← Anterior", admin_deleted_path(page: @page - 1), rel: "prev", class: "bg-gray-200 hover:bg-gray-300 font-bold py-2 px-4 rounded" %>
      <% else %>
        <span class="text-gray-400 font-bold py-2 px-4">← Anterior</span>
      <% end %>
      <span class="text-sm text-gray-600"><%= @page %> / <%= @total_pages %></span>
      <% if @page < @total_pages %>
        <%= link_to "Próxima →", admin_deleted_path(page: @page + 1), rel: "next", class: "bg-gray-200 hover:bg-gray-300 font-bold py-2 px-4 rounded" %>
      <% else %>
        <span class="text-gray-400 font-bold py-2 px-4">Próxima →</span>
      <% end %>
    </nav>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "← Painel admin", admin_index_path, class: "inline-block bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg" %>
  </div>
</div>
