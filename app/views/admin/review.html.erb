<div class="bg-white rounded-2xl shadow-xl p-4 sm:p-6 border-4 border-black">
  <h1 class="text-2xl sm:text-3xl font-black mb-2 text-center">📋 Fila de revisão</h1>
  <p class="text-sm text-gray-600 text-center mb-4">
    Opções novas já estão no ar. <strong>Aprovar</strong> tira da fila; <strong>Reprovar</strong> exclui de vez (com os votos) e guarda o texto em “Opções excluídas”.
    Opções com <%= Option::REPORT_THRESHOLD %> denúncias saem do ar e voltam para cá.
  </p>

  <% if notice %>
    <p class="bg-green-100 border-2 border-green-400 text-green-700 px-4 py-3 rounded mb-4"><%= notice %></p>
  <% end %>

  <p class="text-sm text-gray-600 mb-3"><%= @total %> na fila • página <%= @page %> de <%= @total_pages %> • mais antigas primeiro</p>

  <% if @options.any? %>
    <ul class="space-y-3">
      <% @options.each do |option| %>
        <li class="border-2 <%= option.status == "approved" ? "border-yellow-300 bg-yellow-50" : "border-red-300 bg-red-50" %> rounded-lg p-3">
          <p class="font-bold text-lg break-words"><%= option.text %></p>
          <p class="text-xs text-gray-600 mt-1">
            <span class="inline-block rounded px-2 py-0.5 font-bold <%= option.category == "bad" ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800" %>"><%= Option::CATEGORY_LABELS[option.category] %></span>
            <% if option.status == "approved" %>
              <span class="inline-block rounded px-2 py-0.5 font-bold bg-yellow-100 text-yellow-800">No ar</span>
            <% else %>
              <span class="inline-block rounded px-2 py-0.5 font-bold bg-red-100 text-red-800">Fora do ar (denúncias)</span>
            <% end %>
            • ID <%= option.id %> • <%= option.created_at.strftime("%d/%m/%Y %H:%M") %>
            • <%= @vote_counts[option.id].to_i %> votos • <%= option.report_count %> denúncias
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <%= button_to "✓ Aprovar", admin_approve_path(option), method: :post, form: { class: "inline" },
                class: "bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded" %>
            <%= button_to "✗ Reprovar", admin_reject_path(option), method: :post, form: { class: "inline" },
                class: "bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded" %>
            <%= link_to "✏️ Editar / categoria", edit_admin_option_path(option),
                class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded inline-block" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 text-center py-6">🎉 Fila vazia.</p>
  <% end %>

  <% if @total_pages > 1 %>
    <nav class="flex items-center justify-between gap-2 mt-4" aria-label="Paginação">
      <% if @page > 1 %>
        <%= link_to "← Anterior", admin_review_path(page: @page - 1), rel: "prev", class: "bg-gray-200 hover:bg-gray-300 font-bold py-2 px-4 rounded" %>
      <% else %>
        <span class="text-gray-400 font-bold py-2 px-4">← Anterior</span>
      <% end %>
      <span class="text-sm text-gray-600"><%= @page %> / <%= @total_pages %></span>
      <% if @page < @total_pages %>
        <%= link_to "Próxima →", admin_review_path(page: @page + 1), rel: "next", class: "bg-gray-200 hover:bg-gray-300 font-bold py-2 px-4 rounded" %>
      <% else %>
        <span class="text-gray-400 font-bold py-2 px-4">Próxima →</span>
      <% end %>
    </nav>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "← Painel admin", admin_index_path, class: "inline-block bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg" %>
  </div>
</div>
