<div class="bg-white rounded-2xl shadow-xl p-4 sm:p-6 border-4 border-black max-w-xl mx-auto">
  <h1 class="text-2xl font-black mb-4 text-center">✏️ Editar opção #<%= @option.id %></h1>

  <% if @option.errors.any? %>
    <div class="bg-red-100 border-2 border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
      <% @option.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <% if @needs_force %>
    <div class="bg-yellow-100 border-2 border-yellow-500 text-yellow-900 px-4 py-3 rounded mb-4" role="alert">
      <p class="font-bold">⚠️ O filtro de moderação barrou este texto (<%= @moderation_reasons.map { |r| { profanity: "palavrão/termo bloqueado", explicit_content: "conteúdo explícito", proper_names: "nome de pessoa/marca" }.fetch(r, r.to_s) }.to_sentence(two_words_connector: " e ", last_word_connector: " e ") %>).</p>
      <p class="text-sm mt-1">Se for uma decisão sua, marque "forçar" e salve novamente.</p>
    </div>
  <% end %>

  <%= form_with model: @option, scope: :option, url: admin_option_path(@option, list_params), method: :patch do |f| %>
    <div class="mb-4">
      <%= f.label :text, "Eu prefiro...", class: "block font-bold mb-2" %>
      <%= f.text_field :text, maxlength: 120, required: true, autocomplete: "off",
          class: "w-full border-2 border-gray-300 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none" %>
      <p class="text-sm text-gray-500 mt-1">Máx. 120 caracteres. Status atual: <%= @option.status_was %>. O status não muda ao editar.</p>
    </div>

    <fieldset class="mb-4">
      <legend class="block font-bold mb-2">Categoria</legend>
      <div class="flex gap-4">
        <% OptionClassifier::CATEGORIES.each do |value| %>
          <label class="flex items-center gap-2 font-bold">
            <%= radio_button_tag "option[category]", value, @option.category == value, id: "option_category_#{value}", class: "w-5 h-5" %>
            <%= Option::CATEGORY_LABELS[value] %>
          </label>
        <% end %>
      </div>
      <p class="text-xs text-gray-500 mt-1">Boa = algo legal de ter/fazer; Ruim = dor, nojo, situação ruim. Os pares só juntam opções da mesma categoria.</p>
    </fieldset>

    <% if @needs_force %>
      <div class="mb-4 flex items-center gap-2">
        <%= check_box_tag "option[force]", "1", false, id: "option_force", class: "w-5 h-5" %>
        <%= label_tag "option_force", "Forçar (ignorar o filtro de moderação)", class: "font-bold" %>
      </div>
    <% end %>

    <div class="flex gap-3">
      <%= f.submit "Salvar", class: "flex-1 bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg cursor-pointer" %>
      <%= link_to "Cancelar", admin_options_path(list_params), class: "flex-1 text-center bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 rounded-lg" %>
    </div>
  <% end %>
</div>
