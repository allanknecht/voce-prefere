<div class="bg-white rounded-2xl shadow-xl p-4 sm:p-6 border-4 border-black">
  <h1 class="text-2xl sm:text-3xl font-black mb-4 text-center">🗂️ Gerenciar opções</h1>

  <% if notice %>
    <p class="bg-green-100 border-2 border-green-400 text-green-700 px-4 py-3 rounded mb-4"><%= notice %></p>
  <% end %>
  <% if alert %>
    <p class="bg-red-100 border-2 border-red-400 text-red-700 px-4 py-3 rounded mb-4"><%= alert %></p>
  <% end %>

  <%= form_with url: admin_options_path, method: :get, class: "flex flex-col sm:flex-row gap-2 mb-4" do %>
    <%= label_tag :q, "Buscar texto", class: "sr-only" %>
    <%= search_field_tag :q, @query, placeholder: "Buscar texto…", maxlength: 120, autocomplete: "off",
        class: "flex-1 border-2 border-gray-300 rounded-lg px-3 py-2 focus:border-purple-500 focus:outline-none" %>
    <%= label_tag :status, "Filtrar por status", class: "sr-only" %>
    <%= select_tag :status,
        options_for_select([ [ "Todas", "" ], [ "No ar", "aprovadas" ], [ "Fora do ar", "fora-do-ar" ] ], @status.to_s),
        class: "border-2 border-gray-300 rounded-lg px-3 py-2 bg-white" %>
    <%= label_tag :category, "Filtrar por categoria", class: "sr-only" %>
    <%= select_tag :category,
        options_for_select([ [ "Boas e ruins", "" ], [ "Boas", "boas" ], [ "Ruins", "ruins" ] ], @category.to_s),
        class: "border-2 border-gray-300 rounded-lg px-3 py-2 bg-white" %>
    <%= submit_tag "Filtrar", name: nil, class: "bg-purple-500 hover:bg-purple-600 text-white font-bold py-2 px-4 rounded-lg cursor-pointer" %>
  <% end %>

  <p class="text-sm text-gray-600 mb-3">
    <%= @total %> <%= @total == 1 ? "opção" : "opções" %> • página <%= @page %> de <%= @total_pages %> • ordem alfabética
  </p>

  <% if @options.any? %>
    <ul class="space-y-3">
      <% @options.each do |option| %>
        <li class="border-2 border-gray-300 rounded-lg p-3">
          <p class="font-bold break-words"><%= option.text %></p>
          <p class="text-xs text-gray-600 mt-1">
            <% if option.status == "approved" %>
              <span class="inline-block rounded px-2 py-0.5 font-bold bg-green-100 text-green-800">No ar</span>
            <% else %>
              <span class="inline-block rounded px-2 py-0.5 font-bold bg-red-100 text-red-800">Fora do ar</span>
            <% end %>
            <span class="inline-block rounded px-2 py-0.5 font-bold <%= option.category == "bad" ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800" %>"><%= Option::CATEGORY_LABELS[option.category] %></span>
            <% if option.needs_review %><span class="inline-block rounded px-2 py-0.5 font-bold bg-yellow-100 text-yellow-800">Em revisão</span><% end %>
            • ID <%= option.id %> • <%= votes_label(@vote_counts[option.id].to_i) %> • <%= reports_label(option.report_count) %>
          </p>
          <div class="flex gap-2 mt-2">
            <%= link_to "✏️ Editar", edit_admin_option_path(option, list_params.slice(:status, :category, :q).merge(page: @page)),
                class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded text-sm" %>
            <%= link_to "🗑️ Excluir", confirm_delete_admin_option_path(option, list_params.slice(:status, :category, :q).merge(page: @page)),
                class: "bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded text-sm" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 text-center py-6">Nenhuma opção encontrada.</p>
  <% end %>

  <% if @total_pages > 1 %>
    <nav class="flex items-center justify-between gap-2 mt-4" aria-label="Paginação">
      <% if @page > 1 %>
        <%= link_to "← Anterior", admin_options_path(status: @status, category: @category, q: @query.presence, page: @page - 1),
            rel: "prev", class: "bg-gray-200 hover:bg-gray-300 font-bold py-2 px-4 rounded" %>
      <% else %>
        <span class="text-gray-400 font-bold py-2 px-4">← Anterior</span>
      <% end %>
      <span class="text-sm text-gray-600"><%= @page %> / <%= @total_pages %></span>
      <% if @page < @total_pages %>
        <%= link_to "Próxima →", admin_options_path(status: @status, category: @category, q: @query.presence, page: @page + 1),
            rel: "next", class: "bg-gray-200 hover:bg-gray-300 font-bold py-2 px-4 rounded" %>
      <% else %>
        <span class="text-gray-400 font-bold py-2 px-4">Próxima →</span>
      <% end %>
    </nav>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "← Painel admin", admin_index_path, class: "inline-block bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg" %>
  </div>
</div>
