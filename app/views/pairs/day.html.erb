<div class="text-center mb-8">
  <h1 class="text-5xl font-black text-white mb-2 drop-shadow-lg">
    ⭐ PAR DO DIA ⭐
  </h1>
  <p class="text-white text-lg opacity-90">
    <%= Date.current.strftime("%d/%m/%Y") %>
  </p>
</div>

<% if @pair %>
  <%= render "shared/voting", pair: @pair, pair_hash: @pair_hash, percentages: @percentages,
             total_votes: @total_votes, votes_label: "votos hoje" %>
<% end %>

<div class="mt-6 text-center">
  <a href="<%= root_path %>" class="inline-block bg-white hover:bg-gray-100 text-gray-900 font-bold py-3 px-8 rounded-xl shadow-lg transform transition hover:scale-105">
    ← Voltar
  </a>
</div>
