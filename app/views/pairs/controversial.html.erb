<% content_for :title, "Pares mais polêmicos — Você Prefere?" %>
<main>
  <section class="card ranking" aria-labelledby="ranking-title">
    <h1 id="ranking-title" class="card-title card-title-lg">🔥 Pares Mais Polêmicos</h1>

    <p class="lead">As escolhas mais divididas da comunidade!</p>

    <% if @controversial_pairs.any? %>
      <ol class="rank-list">
        <% @controversial_pairs.each_with_index do |pair_data, index| %>
          <li class="rank-item">
            <span class="rank-num" aria-label="Posição <%= index + 1 %>">#<%= index + 1 %></span>
            <div class="rank-body">
              <%= render "shared/pair_bars", options: pair_data[:options], percentages: pair_data[:percentages] %>

              <div class="rank-foot">
                <span class="rank-meta"><%= votes_label(pair_data[:total_votes]) %> • <%= pair_data[:controversy].round(1) %> polêmica</span>
                <a href="<%= pair_path(pair_data[:pair_hash]) %>" data-turbo="false" class="btn btn-small">Votar →</a>
              </div>
            </div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="lead">Ainda não há pares polêmicos com votos suficientes.</p>
    <% end %>

    <p class="back"><a href="<%= root_path %>" class="btn btn-primary">← Voltar</a></p>
  </section>
</main>
