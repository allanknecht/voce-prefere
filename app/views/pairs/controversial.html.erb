<div class="bg-white rounded-2xl shadow-xl p-6 border-4 border-black">
  <h1 class="text-3xl font-black mb-6 text-center">🔥 Pares Mais Polêmicos</h1>
  
  <p class="text-gray-600 text-center mb-6">
    As escolhas mais divididas da comunidade!
  </p>

  <% if @controversial_pairs.any? %>
    <div class="space-y-4">
      <% @controversial_pairs.each_with_index do |pair_data, index| %>
        <div class="border-2 border-gray-200 rounded-xl p-4 hover:border-purple-500 transition">
          <div class="flex items-start gap-3">
            <div class="text-2xl font-black text-purple-600 flex-shrink-0">
              #<%= index + 1 %>
            </div>
            <div class="flex-1">
              <%= render "shared/pair_bars", options: pair_data[:options], percentages: pair_data[:percentages] %>
              
              <div class="flex justify-between items-center mt-3">
                <span class="text-xs text-gray-500">
                  <%= votes_label(pair_data[:total_votes]) %> • <%= pair_data[:controversy].round(1) %> polêmica
                </span>
                <a 
                  href="<%= pair_path(pair_data[:pair_hash]) %>" data-turbo="false" 
                  class="text-xs bg-purple-500 hover:bg-purple-600 text-white font-bold py-2 px-4 rounded-lg"
                >
                  Votar →
                </a>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-gray-500">
      Ainda não há pares polêmicos com votos suficientes.
    </p>
  <% end %>

  <div class="mt-6 text-center">
    <a href="<%= root_path %>" class="inline-block bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg transform transition hover:scale-105">
      ← Voltar
    </a>
  </div>
</div>
