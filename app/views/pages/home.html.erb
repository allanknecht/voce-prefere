<div class="text-center mb-8">
  <h1 class="text-5xl font-black text-white mb-2 drop-shadow-lg transform -rotate-2">
    VOCÊ PREFERE? 🤔
  </h1>
  <p class="text-white text-lg opacity-90">Escolha e veja o que os outros escolheram!</p>
</div>

<% if @pair %>
  <%= render "shared/voting", pair: @pair, pair_hash: @pair_hash, percentages: @percentages,
             total_votes: @total_votes, votes_label: "votos",
             next_link: { href: root_path, label: "▶️ Próximo" } %>
<% else %>
  <div class="bg-white rounded-2xl shadow-xl p-8 border-4 border-black text-center">
    <p class="text-2xl font-bold mb-4">😅 Ops!</p>
    <p class="text-gray-600">Não há opções suficientes ainda. Envie algumas!</p>
  </div>
<% end %>

<div class="mt-8 space-y-3">
  <button 
    type="button"
    id="submit-button"
    class="w-full bg-white hover:bg-green-200 text-gray-900 font-bold py-4 px-6 rounded-xl shadow-lg transform transition hover:scale-105"
  >
    ✏️ Enviar sua opção
  </button>
  
  <div class="flex gap-3">
    <a href="<%= pairs_day_path %>" class="flex-1 bg-yellow-300 hover:bg-yellow-400 text-gray-900 font-bold py-3 px-4 rounded-xl shadow-lg text-center transform transition hover:scale-105">
      ⭐ Par do Dia
    </a>
    <a href="<%= pairs_controversial_path %>" class="flex-1 bg-red-400 hover:bg-red-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg text-center transform transition hover:scale-105">
      🔥 Polêmicos
    </a>
  </div>
  
  <a href="<%= pages_about_path %>" class="block text-center text-white text-sm underline opacity-75 hover:opacity-100">
    Termos e Privacidade
  </a>
</div>

<div id="submit-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-md w-full border-4 border-black">
    <h2 class="text-2xl font-black mb-4">Envie sua opção!</h2>
    <form id="submit-form">
      <div class="mb-4">
        <label class="block font-bold mb-2">Eu prefiro...</label>
        <input 
          type="text" 
          id="option-text" 
          maxlength="120" 
          class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none"
          placeholder="Ex: Ter super velocidade"
        >
        <p class="text-sm text-gray-500 mt-1">
          <span id="char-count">0</span>/120 caracteres
        </p>
      </div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-lg">
          Enviar
        </button>
        <button type="button" id="cancel-button" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 rounded-lg">
          Cancelar
        </button>
      </div>
    </form>
    <p id="submit-message" class="mt-3 text-sm text-center"></p>
  </div>
</div>
