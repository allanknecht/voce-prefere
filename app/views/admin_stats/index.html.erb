<% r = @report %>
<div class="bg-white rounded-2xl shadow-xl p-4 sm:p-6 border-4 border-black">
  <h1 class="text-2xl sm:text-3xl font-black mb-2 text-center">📊 Estatísticas</h1>

  <nav class="flex justify-center gap-2 mb-4" aria-label="Período">
    <% Analytics::Report::PERIODS.each do |days| %>
      <%= link_to "#{days} dias", admin_stats_path(dias: days),
          class: "font-bold py-2 px-4 rounded-lg border-2 border-black #{r.days == days ? 'bg-yellow-300' : 'bg-gray-100 hover:bg-gray-200'}",
          "aria-current": (r.days == days ? "page" : nil) %>
    <% end %>
  </nav>

  <p class="text-xs text-gray-600 bg-gray-50 border border-gray-300 rounded p-2 mb-4">
    Sem cookies, sem IP e sem user agent guardados. Visitantes são contados <strong>por dia</strong>
    (o identificador muda todo dia): a mesma pessoa em dois dias conta duas vezes. Horários em Brasília.
    Dados brutos ficam <%= Analytics::RETENTION_DAYS %> dias e depois viram totais diários.
    Bots, Sec-GPC e Do Not Track não são contados.
  </p>

  <section class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6 text-center">
    <% [ [ "Visitas", r.visits ], [ "Visitantes (por dia)", r.unique_visitors ], [ "Retornantes", "#{r.returning_share}%" ], [ "Votos", r.votes ] ].each do |label, value| %>
      <div class="border-2 border-black rounded-lg p-2"><p class="text-2xl font-black"><%= value %></p><p class="text-xs text-gray-600"><%= label %></p></div>
    <% end %>
    <% [ [ "Votos por votante", r.votes_per_voter ], [ "Enquetes por votante/dia", r.polls_per_voter ], [ "Opções enviadas", r.total(:submits) ], [ "Denúncias", r.total(:reports) ] ].each do |label, value| %>
      <div class="border-2 border-gray-300 rounded-lg p-2"><p class="text-xl font-black"><%= value %></p><p class="text-xs text-gray-600"><%= label %></p></div>
    <% end %>
  </section>

  <% unless r.visits.positive? || r.votes.positive? %>
    <p class="text-center text-gray-500 mb-6">Ainda não há dados neste período.</p>
  <% end %>

  <h2 class="font-black text-lg mb-1">Visitas por dia</h2>
  <%= render "admin_stats/bars", rows: r.dates.map { |d| [ d.strftime("%d/%m"), r.day(d)[:visits] ] } %>

  <h2 class="font-black text-lg mt-6 mb-1">Visitantes por dia</h2>
  <%= render "admin_stats/bars", rows: r.dates.map { |d| [ d.strftime("%d/%m"), r.day(d)[:unique_visitors] ] }, color: "stat-bar-pink" %>

  <h2 class="font-black text-lg mt-6 mb-1">Retornantes (visitas de quem já veio em outro dia)</h2>
  <p class="text-sm mb-1"><%= r.total(:returning_visits) %> de <%= r.visits %> visitas = <strong><%= r.returning_share %>%</strong></p>
  <%= render "admin_stats/bars", rows: r.dates.map { |d| [ d.strftime("%d/%m"), r.day(d)[:returning_visits] ] }, color: "stat-bar-green" %>

  <h2 class="font-black text-lg mt-6 mb-1">Votos por dia</h2>
  <%= render "admin_stats/bars", rows: r.dates.map { |d| [ d.strftime("%d/%m"), r.day(d)[:votes] ] } %>
  <p class="text-sm mt-1">Média: <strong><%= r.votes_per_voter %></strong> votos e <strong><%= r.polls_per_voter %></strong> enquetes por votante no dia.</p>

  <h2 class="font-black text-lg mt-6 mb-1">Funil (visitantes por dia somados)</h2>
  <% top = r.funnel.first.last %>
  <table class="w-full text-sm">
    <% r.funnel.each do |label, n| %>
      <tr>
        <td class="pr-2 py-0.5 whitespace-nowrap"><%= label %></td>
        <td class="w-full py-0.5"><span class="stat-bar stat-bar-green <%= bar_width_class(n, top) %>"></span></td>
        <td class="pl-2 py-0.5 text-right font-bold tabular-nums"><%= n %></td>
        <td class="pl-2 py-0.5 text-right text-gray-600 tabular-nums"><%= percent_label(n, top) %></td>
      </tr>
    <% end %>
  </table>

  <h2 class="font-black text-lg mt-6 mb-1">Origem do tráfego</h2>
  <% sources = r.sources %>
  <% if sources.any? %>
    <%= render "admin_stats/bars", rows: sources.first(15), color: "stat-bar-pink" %>
  <% else %>
    <p class="text-sm text-gray-500">Sem dados.</p>
  <% end %>
  <p class="text-sm mt-1">Visitas por link compartilhado: <strong><%= r.total(:via_share_visits) %></strong> • cliques em Compartilhar: <strong><%= r.total(:shares) %></strong></p>

  <h2 class="font-black text-lg mt-6 mb-1">Horários de pico (Brasília)</h2>
  <%= render "admin_stats/bars", rows: r.hours.each_with_index.map { |n, h| [ format("%02dh", h), n ] } %>

  <h2 class="font-black text-lg mt-6 mb-1">Celular × computador</h2>
  <%= render "admin_stats/bars", rows: r.devices.to_a, color: "stat-bar-green" %>

  <h2 class="font-black text-lg mt-6 mb-1">Opções enviadas e denúncias por dia</h2>
  <table class="w-full text-sm">
    <tr class="text-left text-gray-600"><th>Dia</th><th class="text-right">Opções</th><th class="text-right">Denúncias</th></tr>
    <% r.dates.each do |d| %>
      <% next if r.day(d)[:submits].zero? && r.day(d)[:reports].zero? %>
      <tr><td><%= d.strftime("%d/%m") %></td><td class="text-right"><%= r.day(d)[:submits] %></td><td class="text-right"><%= r.day(d)[:reports] %></td></tr>
    <% end %>
  </table>

  <h2 class="font-black text-lg mt-6 mb-1">Enquetes mais votadas</h2>
  <% polls = r.top_polls %>
  <% if polls.any? %>
    <ol class="list-decimal pl-5 text-sm space-y-1">
      <% polls.each do |poll| %>
        <li><%= poll[:options].map { |o| o&.text || "(excluída)" }.join(" × ") %> — <strong><%= votes_label(poll[:votes]) %></strong></li>
      <% end %>
    </ol>
  <% else %>
    <p class="text-sm text-gray-500">Sem votos no período.</p>
  <% end %>

  <h2 class="font-black text-lg mt-6 mb-1">Enquetes mais polêmicas</h2>
  <% controversial = r.controversial_polls %>
  <% if controversial.any? %>
    <ol class="list-decimal pl-5 text-sm space-y-1">
      <% controversial.each do |c| %>
        <li><%= c[:options].map(&:text).join(" × ") %> — <%= c[:percentages].values.map { |v| "#{v}%" }.join(" / ") %> (<%= votes_label(c[:total_votes]) %>)</li>
      <% end %>
    </ol>
  <% else %>
    <p class="text-sm text-gray-500">Ainda não há enquetes com votos suficientes.</p>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to "← Painel", admin_index_path, class: "inline-block bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg" %>
  </div>
</div>
