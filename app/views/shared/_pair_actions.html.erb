<%# Votar (results URL only) / Compartilhar / Próximo. Plain links: a full document load every time.
    locals: screen (PairScreen) %>
<div class="actions-row">
  <% if screen.show_results %>
    <a href="<%= pair_path(screen.pair_hash) %>" data-turbo="false" class="btn btn-vote">🗳️ Votar</a>
  <% end %>
  <button type="button" id="share-button" class="btn btn-share">📤 Compartilhar</button>
  <a
    href="<%= screen.next_href %>"
    id="next-link"
    data-turbo="false"
    data-candidates="<%= screen.next_candidates.join(" ") %>"
    class="btn btn-next"
  >Próximo ▶️</a>
</div>
