<%# The RESULTS view (hidden until the visitor voted, or shown on the explicit results URL).
    locals: screen (PairScreen) %>
<div id="results"<%= " class=hidden".html_safe unless screen.show_results %>>
  <section class="card results" aria-labelledby="results-title">
    <h2 id="results-title" class="card-title">Resultados:</h2>
    <%= render "shared/pair_bars", options: screen.pair, percentages: screen.percentages, size: :large, live: true %>
    <p class="total"><span id="total-votes"><%= votes_label(screen.total_votes, screen.votes_suffix) %></span></p>
  </section>

  <%= render "shared/pair_actions", screen: screen %>
</div>
