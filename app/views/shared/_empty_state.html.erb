<%# Friendly full-page state when there is no valid poll to show (never an empty card). %>
<div id="empty-state" class="bg-white rounded-2xl shadow-xl p-8 border-4 border-black text-center">
  <p class="text-2xl font-bold mb-4">😅 Ops!</p>
  <p class="text-gray-600 mb-4">Não há opções suficientes ainda. Envie algumas!</p>
  <a href="<%= root_path %>" class="inline-block bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg">Tentar de novo</a>
</div>
