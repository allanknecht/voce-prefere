<%# Friendly full-page state when there is no valid poll to show (never an empty card). %>
<section id="empty-state" class="card empty">
  <p class="empty-emoji" aria-hidden="true">😅</p>
  <h2 class="card-title">Ops!</h2>
  <p class="empty-text">Não há opções suficientes ainda. Envie algumas!</p>
  <a href="<%= root_path %>" class="btn btn-primary">Tentar de novo</a>
</section>
