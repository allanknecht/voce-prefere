<%# The VOTE view: two option buttons + the visible "Ver resultado" link + the error message slot.
    locals: screen (PairScreen) %>
<div class="duel<%= " hidden" if screen.show_results %>" role="group" aria-label="Escolha uma opção">
  <% screen.pair.each_with_index do |option, index| %>
    <% if index == 1 %><span class="vs" aria-hidden="true">VS</span><% end %>
    <button
      type="button"
      class="vote-button <%= index.zero? ? "opt-a" : "opt-b" %>"
      data-option-id="<%= option.id %>"
    >
      <span class="opt-tag" aria-hidden="true">Opção <%= index.zero? ? "A" : "B" %></span>
      <span class="opt-text"><%= option.text %></span>
    </button>
  <% end %>
</div>

<% unless screen.show_results %>
  <p class="see-results">
    <a href="<%= pair_results_path(screen.pair_hash) %>" id="see-results-link" data-turbo="false" class="btn btn-ghost">👀 Ver resultado</a>
  </p>
<% end %>

<p id="vote-message" class="alert" role="alert" hidden></p>
