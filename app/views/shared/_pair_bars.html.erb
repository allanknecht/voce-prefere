<%# One bar per option: text, percentage and bar. Used by the results view and the Polêmicos ranking.
    locals: options, percentages ({ option_id => pct }), size (:large for the results view),
            live (true: adds the data attributes application.js updates after a vote)

    No inline style (CSP style-src 'self'): the width is the .bar-w-N class (N = rounded percentage);
    application.js then sets the exact width through the CSSOM from data-width. The bar is decorative
    (aria-hidden): the percentage next to it is the accessible text. The leading option(s) get
    .is-winner (application.js moves it after a vote). %>
<% large = local_assigns[:size] == :large %>
<% live = local_assigns[:live] %>
<% top = options.map { |option| percentages[option.id].to_f }.max.to_f %>
<% options.each do |option| %>
  <% pct = percentages[option.id] || 0 %>
  <div class="bar-row<%= " is-winner" if top.positive? && pct.to_f == top %>">
    <div class="bar-head">
      <span class="bar-label"><%= option.text %></span>
      <span class="bar-pct"<% if live %> data-option-id="<%= option.id %>-percentage"<% end %>><%= pct %>%</span>
    </div>
    <div class="bar<%= " bar-sm" unless large %>" aria-hidden="true">
      <div
        class="bar-fill bar-w-<%= pct.to_f.round.clamp(0, 100) %>"
        <% if live %>data-option-id="<%= option.id %>-bar"<% end %>
        data-width="<%= pct %>"
      ></div>
    </div>
  </div>
<% end %>
