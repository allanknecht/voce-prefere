<%# Under every poll screen: "Enviar sua opção" (+ its modal form), Par do Dia / Polêmicos, Termos %>
<footer class="foot">
  <button type="button" id="submit-button" class="btn btn-submit">✏️ Enviar sua opção</button>

  <%= render "shared/nav_buttons" %>

  <a href="<%= pages_about_path %>" class="terms">Termos e Privacidade</a>
</footer>

<div id="submit-modal" class="modal-backdrop hidden">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="submit-title">
    <h2 id="submit-title" class="modal-title">Envie sua opção!</h2>
    <form id="submit-form" novalidate>
      <div class="field">
        <label class="label" for="option-text">Eu prefiro...</label>
        <input
          type="text"
          id="option-text"
          maxlength="120"
          class="input"
          placeholder="Ex: Ter super velocidade"
          autocomplete="off"
        >
        <p class="count"><span id="char-count">0</span>/120 caracteres</p>
      </div>
      <fieldset class="field">
        <legend class="label">Essa opção é... <span class="req" aria-hidden="true">*</span></legend>
        <div class="choices">
          <label for="category-good" class="choice choice-good">
            <input type="radio" name="category" id="category-good" value="good" required>
            <span>👍 Boa</span>
          </label>
          <label for="category-bad" class="choice choice-bad">
            <input type="radio" name="category" id="category-bad" value="bad" required>
            <span>👎 Ruim</span>
          </label>
        </div>
        <p class="help">Boa = algo legal de ter ou fazer. Ruim = dor, nojo ou situação ruim (as duas opções de um par são sempre do mesmo tipo).</p>
      </fieldset>
      <div class="modal-actions">
        <button type="submit" class="btn btn-primary">Enviar</button>
        <button type="button" id="cancel-button" class="btn btn-secondary">Cancelar</button>
      </div>
    </form>
    <p id="submit-message" class="form-message" role="status"></p>
  </div>
</div>
