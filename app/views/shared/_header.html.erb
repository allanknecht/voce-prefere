<%# locals: title (default "VOCÊ PREFERE? 🤔"), subtitle (optional), tilted (default true) %>
<% tilted = local_assigns.fetch(:tilted, true) %>
<div class="text-center mb-8">
  <h1 class="text-5xl font-black text-white mb-2 drop-shadow-lg<%= " transform -rotate-2" if tilted %>">
    <%= local_assigns[:title] || "VOCÊ PREFERE? 🤔" %>
  </h1>
  <% if local_assigns[:subtitle] %>
    <p class="text-white text-lg opacity-90"><%= local_assigns[:subtitle] %></p>
  <% end %>
</div>
