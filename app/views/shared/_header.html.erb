<%# locals: title (optional: one single label, e.g. "⭐ Par do Dia"), subtitle (optional tagline).
    Default: the two-tag "Você prefere?" logo. Natural case here, uppercase comes from CSS. %>
<header class="hero">
  <h1 class="logo<%= " logo-day" if local_assigns[:title] %>">
    <% if local_assigns[:title] %>
      <span class="logo-a"><%= local_assigns[:title] %></span>
    <% else %>
      <span class="logo-a">Você</span> <span class="logo-b">prefere?</span>
    <% end %>
  </h1>
  <% if local_assigns[:subtitle] %>
    <p class="tagline"><%= local_assigns[:subtitle] %></p>
  <% end %>
</header>
