<%# locals: pair, pair_hash, percentages, total_votes, votes_suffix (optional, e.g. "hoje"),
          next_candidates (pair hashes, same category, none is the current one), next_label,
          show_results (optional: explicit results URL) %>
<% show_results = local_assigns[:show_results] %>
<% next_candidates = Array(local_assigns[:next_candidates]) %>
<% next_href = next_candidates.any? ? pair_path(next_candidates.first) : root_path %>
<div id="voting-container" data-pair-hash="<%= pair_hash %>" data-votes-suffix="<%= local_assigns[:votes_suffix] %>"<% if show_results %> data-results-shown="true"<% end %>>
  <div class="space-y-4 mb-6<%= " hidden" if show_results %>">
    <% pair.each do |option| %>
      <button
        type="button"
        class="vote-button w-full bg-white hover:bg-yellow-200 text-gray-900 font-bold py-6 px-6 rounded-2xl shadow-xl transform transition hover:scale-105 hover:rotate-1 text-xl border-4 border-black"
        data-option-id="<%= option.id %>"
      >
        <%= option.text %>
      </button>
    <% end %>
  </div>

  <% unless show_results %>
    <p class="mb-4 text-center">
      <a href="<%= pair_results_path(pair_hash) %>" id="see-results-link" class="inline-block bg-white hover:bg-yellow-200 text-gray-900 font-bold py-2 px-5 rounded-xl border-4 border-black shadow-lg">👀 Ver resultado</a>
    </p>
  <% end %>

  <p id="vote-message" class="mb-4 text-center font-bold text-white bg-red-600 rounded-xl border-4 border-black p-3" role="alert" hidden></p>

  <div id="results"<%= " class=hidden".html_safe unless show_results %>>
    <div class="bg-white rounded-2xl shadow-xl p-6 border-4 border-black">
      <h2 class="text-2xl font-black mb-4 text-center">RESULTADOS:</h2>
      <div class="space-y-3">
        <% pair.each do |option| %>
          <div>
            <div class="flex justify-between mb-1">
              <span class="font-bold text-sm"><%= option.text %></span>
              <span class="font-bold text-sm" data-option-id="<%= option.id %>-percentage">
                <%= percentages[option.id] || 0 %>%
              </span>
            </div>
            <div class="bg-gray-200 rounded-full h-6 overflow-hidden border-2 border-black">
              <div
                class="bg-gradient-to-r from-purple-500 to-pink-500 h-full transition-all duration-500"
                data-option-id="<%= option.id %>-bar"
                data-width="<%= percentages[option.id] || 0 %>"
              ></div>
            </div>
          </div>
        <% end %>
      </div>
      <p class="text-center mt-4 text-gray-600">
        <span id="total-votes"><%= votes_label(total_votes, local_assigns[:votes_suffix]) %></span>
      </p>
    </div>

    <div class="mt-6 flex gap-3">
      <% if show_results %>
        <a href="<%= pair_path(pair_hash) %>" class="flex-1 bg-white hover:bg-yellow-200 text-gray-900 font-bold py-3 px-4 rounded-xl border-4 border-black shadow-lg text-center">🗳️ Votar</a>
      <% end %>
      <button
        type="button"
        id="share-button"
        class="flex-1 bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-6 rounded-xl shadow-lg transform transition hover:scale-105"
      >
        📤 Compartilhar
      </button>
      <a
        href="<%= next_href %>"
        id="next-link"
        data-candidates="<%= next_candidates.join(" ") %>"
        class="flex-1 bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-xl shadow-lg transform transition hover:scale-105 text-center"
      >
        <%= local_assigns[:next_label] || "▶️ Próximo" %>
      </a>
    </div>
  </div>
</div>
