<div class="bg-white rounded-2xl shadow-xl p-8 border-4 border-black max-w-md mx-auto">
  <h1 class="text-3xl font-black mb-6 text-center">🔒 Admin Login</h1>

  <% if flash[:error] %>
    <div class="bg-red-100 border-2 border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <%= flash[:error] %>
    </div>
  <% end %>

  <%= form_with url: admin_login_path, method: :post do |f| %>
    <div class="mb-4">
      <label for="secret" class="block font-bold mb-2">Senha Admin:</label>
      <%= f.password_field :secret, 
          id: "secret",
          class: "w-full border-2 border-gray-300 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none",
          placeholder: "Digite a senha admin",
          required: true,
          autocomplete: "off" %>
    </div>

    <div class="mb-4">
      <%= f.submit "Entrar", 
          class: "w-full bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-6 rounded-lg shadow-lg cursor-pointer" %>
    </div>
  <% end %>

  <div class="text-center">
    <a href="<%= root_path %>" class="text-sm text-gray-600 hover:text-gray-800 underline">
      ← Voltar ao site
    </a>
  </div>
</div>
