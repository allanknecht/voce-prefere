# Environment variables for "Você Prefere?"
# Copy the names into Render's dashboard (or `export` them locally). Never commit real values.

# --- Required in production (the app refuses to boot without the first three) ---------------
# Rails secret (also salts the anti-spam IP hashes).   Generate: bin/rails secret
SECRET_KEY_BASE=
# Admin password for /admin/login. Must be >= 16 chars and not the old placeholder.
#   Generate: openssl rand -hex 32
ADMIN_SECRET=
# PostgreSQL connection string, e.g. from Neon (free): copy it from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Optional ------------------------------------------------------------------------------
# RAILS_LOG_LEVEL=info
# RAILS_MAX_THREADS=3
# PORT=3000           (Render sets this for you)

# Development and test need none of the above: they use SQLite (storage/*.sqlite3) and a
# built-in dev-only admin password ("dev-admin-secret").
